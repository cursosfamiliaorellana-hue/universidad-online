# ==============================================================================
# .gitignore - Bot Universidad Online
# Protege binarios pesados (>100MB), videos multimedia y credenciales privadas.
# ==============================================================================

# Binarios y ejecutables pesados (GitHub rechaza archivos > 100MB)
ffmpeg.exe
cloudflared.exe
*.exe
git/
libs/

# Carpetas de grabaciones, videos y audios pesados (Multimedia no va a Git)
grabaciones/
Para_NotebookLM/
*.mp4
*.mp3
*.m4a
*.webm
*.zip
*.crdownload
temp_*/

# Perfiles de navegador Chrome, vigía y cachés
perfil_chrome/
perfil_vigia/
__pycache__/
*.pyc
logs_*.txt
logs_ffmpeg.txt

# Sesiones de Telegram y credenciales privadas
*.session
sesion_telegram.session
sesion_vigia.session
login_state.json
config.json
_backups_db/

# ==============================================================================
# DISASTER RECOVERY & CEREBRO DE DATOS
# INCLUIR explícitamente la base de datos central de conocimiento acumulado
# ==============================================================================
!clases.db
*.db.bak
