# ==============================================================================
# .gitignore - Bot Universidad Online
# Protege archivos privados, credenciales, perfiles y binarios pesados (>100MB)
# ==============================================================================

# Binarios y ejecutables pesados (GitHub rechaza archivos > 100MB como ffmpeg)
ffmpeg.exe
cloudflared.exe
*.exe
git/
libs/

# Carpetas de grabaciones, videos y audios pesados
grabaciones/
Para_NotebookLM/
*.mp4
*.mp3
*.m4a
*.webm
*.zip
temp_*/

# Perfil de navegador Chrome y cachés
perfil_chrome/
__pycache__/
*.pyc

# Base de datos local y sesiones privadas
clases.db
*.db
*.session
sesion_telegram.session
sesion_vigia.session
login_state.json
config.json
